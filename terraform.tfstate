rties.spec.properties.options.maxProperties=b17ef6d19c7a5b1ee83b907c595526dcb1eb06db8227d650d5dda0a9f4ce8cd9\nspec.versions.0.schema.openAPIV3Schema.properties.spec.properties.options.type=2958d416d08aa5a472d7b509036cb7eafd542add84527e66a145ea64cb4cdc75\nspec.versions.0.schema.openAPIV3Schema.properties.spec.properties.targetRefs.description=9b3fc0fea89d90ebda2b116d6afc82adeeece90c6d028ca2fb24dbaf701f7afd\nspec.versions.0.schema.openAPIV3Schema.properties.spec.properties.targetRefs.items.description=71273ae4bf6b2a27ae85b25b3e1e627007792eda7966eb74274bd336590e1172\nspec.versions.0.schema.openAPIV3Schema.properties.spec.properties.targetRefs.items.properties.group.description=bcfb87f95d40a7b06eba9a80e5c83404d83224154b71ef9196e6ce49a0d9ec67\nspec.versions.0.schema.openAPIV3Schema.properties.spec.properties.targetRefs.items.properties.group.maxLength=e7866fdc6672f827c76f6124ca3eeaff44aff8b7caf4ee1469b2ab887e7e7875\nspec.versions.0.schema.openAPIV3Schema.properties.spec.properties.targetRefs.items.properties.group.pattern=d3ac4150e26e459da8768ee80c88d43ba5c04447d0948f49984e5b8b90daa6eb\nspec.versions.0.schema.openAPIV3Schema.properties.spec.properties.targetRefs.items.properties.group.type=473287f8298dba7163a897908958f7c0eae733e25d2e027992ea2edc9bed2fa8\nspec.versions.0.schema.openAPIV3Schema.properties.spec.properties.targetRefs.items.properties.kind.description=3f9f00f6b42137394be0b25fe59b4a7f96928fb09d3758c2e934529ec9ea039e\nspec.versions.0.schema.openAPIV3Schema.properties.spec.properties.targetRefs.items.properties.kind.maxLength=da4ea2a5506f2693eae190d9360a1f31793c98a1adade51d93533a6f520ace1c\nspec.versions.0.schema.openAPIV3Schema.properties.spec.properties.targetRefs.items.properties.kind.minLength=6b86b273ff34fce19d6b804eff5a3f5747ada4eaa22f1d49c01e52ddb7875b4b\nspec.versions.0.schema.openAPIV3Schema.properties.spec.properties.targetRefs.items.properties.kind.pattern=bedae318568c81cedc55a1eb429f34adc4dfd77d1ac408971278b77134925da5\nspec.versions.0.schema.openAPI